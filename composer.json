{
    "name": "angelohd/laravel-backup",
    "description": "Biblioteca Laravel para realizar backup automatico da base de dados.",
    "type": "library",
    "keywords": [
        "laravel",
        "backup",
        "database",
        "mysql",
        "mariadb",
        "dump",
        "restore"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Angelo N. Mwadiavita",
            "email": "amwadiavita@ndaysystem.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "angelohd\\Backup\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "angelohd\\Backup\\BackupServiceProvider"
            ]
        },
        "social": {
            "github": "https://github.com/angelohd",
            "linkedin": "https://www.linkedin.com/in/angelo-mwadiavita-446843183/"
        }
    },
    "require": {
        "php": "^8.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0"
    },
    "suggest": {
        "ext-zlib": "Para compressao gzip dos backups."
    }
}
